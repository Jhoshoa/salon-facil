# Copy this file to `.env` in the repo root before running docker-compose.prod.yml or
# deploy/init-letsencrypt.sh — docker compose loads a `.env` file next to the compose file
# automatically for ${VAR} interpolation. See docs/deploy/hostinger-vps.md for the full guide.
#
# Never commit the real `.env` — it holds production secrets.

# ============================================
# DOMINIOS
# ============================================
# DNS A records for both must already point at this server's IP before running
# deploy/init-letsencrypt.sh.
APP_DOMAIN=app.salonfacil.bo
API_DOMAIN=api.salonfacil.bo
LETSENCRYPT_EMAIL=admin@salonfacil.bo

# ============================================
# BASE DE DATOS
# ============================================
# Generate with: openssl rand -base64 32
POSTGRES_PASSWORD=

# ============================================
# AUTENTICACION JWT
# ============================================
# Generate each with: openssl rand -base64 48
JWT_SECRET=
JWT_REFRESH_SECRET=

# ============================================
# CLOUDINARY
# ============================================
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ============================================
# TWILIO WHATSAPP
# ============================================
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_NUMBER=whatsapp:+14155238886

# ============================================
# RESEND EMAIL
# ============================================
RESEND_API_KEY=
RESEND_FROM_EMAIL=noreply@salonfacil.bo

# ============================================
# GOOGLE MAPS
# ============================================
GOOGLE_MAPS_API_KEY=

# ============================================
# MONITOREO
# ============================================
SENTRY_DSN=
