# Copy this file to `.env` in the repo root before running docker-compose.prod.yml or
# deploy/init-letsencrypt.sh — docker compose loads a `.env` file next to the compose file
# automatically for ${VAR} interpolation. See docs/deploy/hostinger-vps.md for the full guide.
#
# Never commit the real `.env` — it holds production secrets.

# ============================================
# DOMINIOS
# ============================================
# DNS A records for both must already point at this server's IP before running
# deploy/init-letsencrypt.sh.
APP_DOMAIN=app.salonfacil.bo
API_DOMAIN=api.salonfacil.bo
LETSENCRYPT_EMAIL=admin@salonfacil.bo

# ============================================
# BASE DE DATOS
# ============================================
# Generate with: openssl rand -base64 32
POSTGRES_PASSWORD=

# ============================================
# AUTENTICACION JWT
# ============================================
# Generate each with: openssl rand -base64 48
JWT_SECRET=
JWT_REFRESH_SECRET=

# ============================================
# CLOUDINARY
# ============================================
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ============================================
# TWILIO WHATSAPP
# ============================================
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_NUMBER=whatsapp:+14155238886

# ============================================
# AWS SES EMAIL
# ============================================
AWS_REGION=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
SES_FROM_EMAIL=noreply@salonfacil.bo

# ============================================
# GOOGLE MAPS
# ============================================
GOOGLE_MAPS_API_KEY=

# ============================================
# GOOGLE OAUTH (sign-in with Google)
# ============================================
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=

# ============================================
# CUENTA ADMIN INICIAL
# ============================================
# Solo la lee prisma/seed-admin.ts (un script aparte, nunca corre solo) — no es config de la
# app en si. Elegi vos mismo el email/telefono/contrasena reales; nunca se guardan en el repo.
# Corre una sola vez: docker compose -f docker-compose.prod.yml exec backend npm run prisma:seed:admin
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_PHONE=
ADMIN_FULL_NAME=

# ============================================
# MONITOREO
# ============================================
SENTRY_DSN=
