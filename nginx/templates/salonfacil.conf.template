# Templated by the nginx image's own entrypoint (envsubst over $APP_DOMAIN / $API_DOMAIN,
# passed as environment vars on the nginx service in docker-compose.prod.yml) into
# /etc/nginx/conf.d/salonfacil.conf on container start. Do not edit the generated file — edit
# this template and restart the nginx container instead.
#
# Two subdomains, one cert (issued with `-d $APP_DOMAIN -d $API_DOMAIN`, see
# deploy/init-letsencrypt.sh) — matches the same-registrable-domain requirement the backend's
# auth cookies already assume (see backend/src/modules/auth/interface/auth-cookies.util.ts).

# --- HTTP: ACME challenge + redirect everything else to HTTPS ---
server {
    listen 80;
    server_name ${APP_DOMAIN} ${API_DOMAIN};

    location /.well-known/acme-challenge/ {
        root /var/www/certbot;
    }

    location / {
        return 301 https://$host$request_uri;
    }
}

# --- Frontend (Next.js) ---
server {
    listen 443 ssl;
    http2 on;
    server_name ${APP_DOMAIN};

    ssl_certificate     /etc/letsencrypt/live/${APP_DOMAIN}/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/${APP_DOMAIN}/privkey.pem;

    client_max_body_size 15m;

    location / {
        proxy_pass http://frontend:3000;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }
}

# --- Backend (NestJS API) ---
server {
    listen 443 ssl;
    http2 on;
    server_name ${API_DOMAIN};

    ssl_certificate     /etc/letsencrypt/live/${APP_DOMAIN}/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/${APP_DOMAIN}/privkey.pem;

    # Payment-proof / venue photo uploads go through here — keep in sync with
    # backend/src/modules/venue/interface/venue.controller.ts's own per-file size limit.
    client_max_body_size 15m;

    location / {
        proxy_pass http://backend:3001;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }
}
