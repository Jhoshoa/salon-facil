# Read by docker-compose.yml via ${VAR} substitution when running `make up` / `docker compose up`.
# Copy to `.env` (gitignored) and fill in real values. For running the backend directly with
# `npm run start:dev` (outside Docker), these same three keys also need to be set in
# backend/.env.local instead — see backend/.env.example.
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret
